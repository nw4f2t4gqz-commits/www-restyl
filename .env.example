# Local-only settings. Copy this file to .env before starting the stack.
# The bind addresses intentionally expose the web UI only on this computer.
SITE_BIND=127.0.0.1
SITE_PORT=8081
MAILPIT_BIND=127.0.0.1
MAILPIT_UI_PORT=8026
# Set only behind a trusted proxy that overwrites X-Forwarded-Proto.
RESTYL_REVERSE_PROXY_ADDRESS=

# These credentials are for disposable local development only.
MARIADB_DATABASE=restyl
MARIADB_USER=restyl
MARIADB_PASSWORD=restyl_local_dev_only
MARIADB_ROOT_PASSWORD=restyl_root_local_dev_only

# Reserved .test recipients: Mailpit captures mail and never delivers it externally.
RESTYL_MAIL_FROM=drupal@example.test
RESTYL_MAIL_TO_ELEKTRO=elektro@example.test
RESTYL_MAIL_TO_ENERGY=energy@example.test
