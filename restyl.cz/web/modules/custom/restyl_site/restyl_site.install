<?php

/**
 * @file
 * Installation of the RESTYL editor role.
 */

use Drupal\block\Entity\Block;
use Drupal\block_content\Entity\BlockContent;
use Drupal\menu_link_content\Entity\MenuLinkContent;
use Drupal\user\Entity\Role;

/**
 * Implements hook_install().
 */
function restyl_site_install() {
  Role::load('anonymous')->grantPermission('search content')->save();
  Role::load('authenticated')->grantPermission('search content')->save();
  foreach (['restyl_account_menu', 'restyl_help', 'restyl_breadcrumbs', 'restyl_main_menu', 'restyl_powered'] as $block_id) {
    if ($block = Block::load($block_id)) {
      $block->disable()->save();
    }
  }
  if ($title_block = Block::load('restyl_page_title')) {
    $title_block->setRegion('content')->setWeight(-5);
    $title_block->setVisibilityConfig('request_path', [
      'id' => 'request_path',
      'pages' => '<front>',
      'negate' => TRUE,
      'context_mapping' => [],
    ]);
    $title_block->save();
  }
  if (!Role::load('restyl_editor')) {
    Role::create([
      'id' => 'restyl_editor',
      'label' => 'Redaktor RESTYL',
    ])
      ->grantPermission('access administration pages')
      ->grantPermission('access navigation')
      ->grantPermission('view the administration theme')
      ->grantPermission('access content overview')
      ->grantPermission('access block library')
      ->grantPermission('edit any basic block content')
      ->grantPermission('create page content')
      ->grantPermission('edit any page content')
      ->grantPermission('view own unpublished content')
      ->grantPermission('use text format basic_html')
      ->grantPermission('use text format restyl_html')
      ->save();
  }

  $links = [
    ['ELEKTRO', 'internal:/elektro/', 0],
    ['ENERGY', 'https://restylenergy.cz/', 1],
    ['PLAN', 'https://www.restylplan.cz/', 2],
    ['KONTAKT', 'internal:/kontakt/', 3],
  ];
  foreach ($links as [$title, $uri, $weight]) {
    MenuLinkContent::create([
      'title' => $title,
      'link' => ['uri' => $uri],
      'menu_name' => 'main',
      'weight' => $weight,
    ])->save();
  }

  restyl_site_configure_footer_blocks();

  restyl_site_create_utility_blocks();
}

